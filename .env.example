# Required: The Odds API key. This repo never needs a Polymarket private key.
ODDS_API_KEY=

# Storage and cadence
DB_PATH=./mlb_poly.sqlite
POLL_SECONDS=30
ODDS_REFRESH_SECONDS=120
ODDS_REGIONS=us
# Optional override. Example: ODDS_BOOKMAKERS=pinnacle,betfair_ex_uk
ODDS_BOOKMAKERS=
MIN_BOOKS=3
MAX_ODDS_AGE_SECONDS=300

# Thesis: no-vig fair probability must clear all-in cost by this amount.
MIN_NET_EDGE=0.035
MIN_MINUTES_TO_START=12
MAX_HOURS_TO_START=48

# Paper execution only
PAPER_TRADE_USD=25
PAPER_BANKROLL_USD=1000
MIN_FILL_FRACTION=0.80
PAPER_DEPTH_HAIRCUT=0.30
PAPER_FRICTION_PER_SHARE=0.003

# Informational overlay only; never an entry gate.
FLOW_MIN_NOTIONAL=2000
FLOW_LOOKBACK_SECONDS=600
LOG_LEVEL=INFO
